  <property name="styleSheet">
   <string notr="true">QMainWindow {
    background-color: #151D29;
    color: #F1F5F9;
    font-family: 'Inter', sans-serif;
}

QWidget {
    background-color: transparent;
    color: #F1F5F9;
}

/* Header Styles */
QFrame#headerFrame {
    background-color: #0F172A;
    border-bottom: 1px solid rgba(148, 163, 184, 0.1);
    backdrop-filter: blur(12px);
}

QLabel#titleLabel {
    color: #F1F5F9;
    font-size: 18px;
    font-weight: bold;
    letter-spacing: -0.025em;
}

QLabel#versionLabel {
    color: #94A3B8;
    font-size: 14px;
    font-weight: normal;
    margin-left: 8px;
}

/* Status Badge with Animation */
QFrame#statusBadge {
    background-color: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.2);
    border-radius: 12px;
    padding: 4px 12px;
}

QLabel#statusDot {
    background-color: #10B981;
    border-radius: 3px;
    min-width: 6px;
    max-width: 6px;
    min-height: 6px;
    max-height: 6px;
}

QLabel#statusLabel {
    color: #10B981;
    font-size: 12px;
    font-weight: 500;
}

/* Video Container with Glow */
QFrame#videoContainer {
    background-color: #000000;
    border: none;
    border-radius: 16px;
}

QLabel#videoLabel {
    background-color: #000000;
    border-radius: 16px;
    border: none;
}

/* Video Overlays */
QLabel#frontViewBadge {
    background-color: rgba(0, 0, 0, 0.5);
    color: #F1F5F9;
}

/* Control Panel */
QFrame#controlPanel {
    background-color: rgba(51, 65, 85, 0.9);
    border: 1px solid rgba(71, 85, 105, 0.5);
    border-radius: 16px;
}

/* Input Fields - Dark Theme */
QLineEdit {
    background-color: rgba(30, 41, 59, 0.8);
    color: #F1F5F9;
    border: 1px solid rgba(51, 65, 85, 0.6);
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 14px;
    selection-background-color: rgba(59, 130, 246, 0.3);
}

QLineEdit:hover {
    border: 1px solid rgba(59, 130, 246, 0.5);
    background-color: rgba(30, 41, 59, 0.9);
}

QLineEdit:focus {
    border: 1px solid #3B82F6;
    background-color: rgba(30, 41, 59, 0.95);
}

QLineEdit::placeholder {
    color: rgba(148, 163, 184, 0.6);
}

/* Buttons - Dark Theme */
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1E293B, stop:1 #334155);
    color: #F1F5F9;
    border: 1px solid rgba(51, 65, 85, 0.5);
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: 500;
    font-size: 14px;
}

QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #334155, stop:1 #475569);
    border: 1px solid #3B82F6;
}

QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1E293B, stop:1 #0F172A);
    border: 1px solid #2563EB;
}

/* Side Panels - Dark */
QFrame#velocityPanel, QFrame#steeringPanel,QFrame#controlPanel {
    background-color: #19243d;
    border: 1px solid rgba(51, 65, 85, 0.5);
    border-radius: 16px;
}

/* Labels - Dark Theme */
QLabel#velocitySectionLabel, QLabel#steeringSectionLabel {
    color: #94A3B8;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

QLabel#tempLabel, QLabel#loadLabel, QLabel#steeringStatusLabel {
    color: #64748B;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

QLabel#tempValue, QLabel#loadValue, QLabel#steeringStatusValue {
    color: #F1F5F9;
    font-size: 14px;
    font-weight: 600;
}

/* Separator */
QLabel#separator {
    background-color: #334155;
}

/* Footer - Dark */
QFrame#footerFrame {
    background-color: #0F172A;
    border-top: 1px solid rgba(51, 65, 85, 0.6);
    color: #94A3B8;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
}

QLabel#footerLabel {
    color: #64748B;
    font-size: 11px;
}

QLabel#smallIconLabel {
    color: #94A3B8;
    font-size: 14px;
}</string>
